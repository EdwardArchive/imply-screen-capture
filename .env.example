# Imply Configuration
IMPLY_BASE_URL=http://your-imply-instance.com:9095/
IMPLY_USERNAME=your@email.com
IMPLY_PASSWORD=yourpassword

# Dashboard Configuration
# 단일 URL 또는 쉼표로 구분된 여러 URL
DASHBOARD_URLS=http://your-imply-instance.com:9095/pivot/dashboard1,http://your-imply-instance.com:9095/pivot/dashboard2
# 또는 단일 URL (하위 호환성)
# DASHBOARD_URL=http://your-imply-instance.com:9095/pivot/dashboard-id

# 로그인 없이 접근 가능한 대시보드 URL (옵션)
# 이 옵션이 설정되면 로그인을 건너뛰고 직접 대시보드를 캡처합니다
# NO_LOGIN_DASHBOARD_URL=http://your-imply-instance.com:9095/public/dashboard

# 대시보드 로드 대기 시간 (밀리초)
DASHBOARD_WAIT_TIME=5000

# Output Configuration
SCREENSHOT_DIR=./screenshots
SCREENSHOT_FORMAT=png  # 'png' 또는 'html'

# Viewport Configuration (PNG 캡처 시 사용)
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080